@page "/admin/login"
@layout Layout.MainLayout
@using Microsoft.AspNetCore.Components.Web

<PageTitle>Sign in — Echolines</PageTitle>

<h1>Sign in</h1>

@if (Error == "unconfigured")
{
    <p class="error">
        No operator password is configured. Set <code>Admin__PasswordHash</code> and restart —
        until then every login is refused on purpose.
    </p>
}
else if (!string.IsNullOrEmpty(Error))
{
    <p class="error">Wrong password.</p>
}

@* A plain form post, not an interactive component: the sign-in cookie needs the real HTTP response.
   It posts to SignInPath, NOT to this page's own route — a component route answers POST too, and two
   equally specific matches make routing throw instead of signing anyone in. *@
<form method="post" action="@AdminEndpoints.SignInPath" class="login">
    <AntiforgeryToken />
    <label for="password">Operator password</label>
    <input id="password" name="password" type="password" autocomplete="current-password" autofocus />
    <button type="submit">Sign in</button>
</form>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }
}
