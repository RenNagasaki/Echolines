<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Nur nuget.org: die global konfigurierten Firmenquellen verlangen eine
       Anmeldung und lassen den Restore sonst mit 401 scheitern. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
