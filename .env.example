# Copy to .env next to docker-compose.yml. Neither value belongs in the repository or the image.

# Postgres password. Free choice, but change it before the first start — it is baked into the
# database volume on creation and changing it afterwards means recreating the volume.
POSTGRES_PASSWORD=

# PBKDF2 hash of the operator password for /admin. NOT the password itself. Generate with:
#   docker compose build server && docker run --rm -it echolines hash-password
# An empty value refuses every login rather than allowing every login.
ADMIN_PASSWORD_HASH=

# true when a reverse proxy terminates TLS in front of the container. See docker-compose.yml.
BEHIND_REVERSE_PROXY=false

# Set to 127.0.0.1 when a reverse proxy is in front, so the plain-HTTP port is not exposed publicly.
BIND_ADDRESS=0.0.0.0
